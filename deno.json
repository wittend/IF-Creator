{
  "name": "if-creator",
  "version": "1.0.0",
  "description": "Visual harness for exploring and generating multi-tier interfaces from C, C++, and Python3 APIs",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --output dist/debian/if-creator src/main.ts",
    "docs": "sphinx-build -b html docs docs/_build/html"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
